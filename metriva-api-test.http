### Metriva API Endpoints - REST Client File
### Base URL: http://localhost:5000
### Use this file with REST Client extension in VS Code or similar

@baseUrl = http://localhost:5000
@contentType = application/json

####################################
# Health Check
####################################
GET {{baseUrl}}/api/health

####################################
# Authentication Endpoints
####################################

### Register New User
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "name": "testuser",
  "email": "testuser1@example.com",
  "password": "SecurePassword123!"
}

### Login User
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "testuser1@example.com",
  "password": "SecurePassword123!"
}

### Refresh Token
POST {{baseUrl}}/api/auth/refresh
Content-Type: {{contentType}}

### Logout User
POST {{baseUrl}}/api/auth/logout
Content-Type: {{contentType}}

### Forgot Password
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "testuser@example.com"
}

### Reset Password
POST {{baseUrl}}/api/auth/reset-password
Content-Type: {{contentType}}

{
  "token": "06dbb5603baad5d64c87a20227c10d4c0108f24c34fc4ffaadb87013a3d0e781",
  "password": "NewSecurePassword456!"
}

### Send OTP
POST {{baseUrl}}/api/auth/send-otp
Content-Type: {{contentType}}

{
  "email": "testuser1@example.com"
}

### Verify OTP
POST {{baseUrl}}/api/auth/verify-otp
Content-Type: {{contentType}}

{
  "email": "testuser1@example.com",
  "otp": "829901"
}

### Resend OTP
POST {{baseUrl}}/api/auth/resend-otp
Content-Type: {{contentType}}

{
  "email": "user@example.com"
}

### Get Current User (Protected)
GET {{baseUrl}}/api/auth/me
Content-Type: {{contentType}}

####################################
# Protected Routes
####################################

### Protected Test Route
GET {{baseUrl}}/api/protected
Content-Type: {{contentType}}

####################################
# Additional Test Scenarios
####################################

### Register with Invalid Email (should fail)
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "name": "testuser2",
  "email": "invalid-email",
  "password": "SecurePassword123!"
}

### Register with Weak Password (should fail)
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "username": "testuser3",
  "email": "testuser3@example.com",
  "password": "123"
}

### Login with Invalid Credentials (should fail)
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "testuser@example.com",
  "password": "WrongPassword123!"
}

### Login with Non-existent User (should fail)
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "nonexistent@example.com",
  "password": "SecurePassword123!"
}

### Forgot Password with Invalid Email (should fail)
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "invalid-email"
}
