### Metriva NestJS API Endpoints - REST Client File
### Base URL: http://localhost:5000 (or http://localhost:5001)
### Use this file with REST Client extension in VS Code or similar HTTP client

# @baseUrl = http://localhost:5000
@baseUrl = https://5qz48i7xan82.shares.zrok.io
@contentType = application/json
@fetchOptions = { "credentials": "include" }

####################################
# Health Check (Public Endpoints)
####################################

### Health Check 1 (/api/health)
GET {{baseUrl}}/api/health

### Health Check 2 (/health)
GET {{baseUrl}}/health


####################################
# Authentication Endpoints
####################################

### 1. Register New User
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "name": "Test User",
  "email": "testuser@example.com",
  "password": "Password123!"
}

### 2. Send OTP (Email Verification)
POST {{baseUrl}}/api/auth/send-otp
Content-Type: {{contentType}}

{
  "email": "testuser@example.com"
}

### 3. Verify OTP (Enter the code printed in server console or email)
POST {{baseUrl}}/api/auth/verify-otp
Content-Type: {{contentType}}

{
  "email": "testuser@example.com",
  "otp": "123456"
}

### 4. Resend OTP
POST {{baseUrl}}/api/auth/resend-otp
Content-Type: {{contentType}}

{
  "email": "testuser@example.com"
}

### 5. Login User
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

# {
#   "email": "admin@metriva.com",
#   "password": "SuperAdmin@123!"
# }

{
  "email": "admin2@agency.com",
  "password": "AdminPass123!"
}

### 6. Get Current Authenticated User (Requires Login Cookie)
GET {{baseUrl}}/api/auth/me
Content-Type: {{contentType}}

### 7. Forgot Password (Request Reset Link)
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "testuser@example.com"
}

### 8. Reset Password (Use token logged to server console or email)
POST {{baseUrl}}/api/auth/reset-password
Content-Type: {{contentType}}

{
  "token": "REPLACE_WITH_RESET_TOKEN_FROM_CONSOLE",
  "password": "NewPassword123!"
}

### 9. Refresh Access Token
POST {{baseUrl}}/api/auth/refresh
Content-Type: {{contentType}}

### 10. Logout User
POST {{baseUrl}}/api/auth/logout
Content-Type: {{contentType}}


####################################
# Organization Endpoints
####################################

# Setting organization and client id
# Replace with the actual values from previous responses
@orgId = 6a860072c19b7485ae62ab74
@clientId = 6a86082e39f321d29d221432

### 11. Create Organization (SUPER_ADMIN only)
POST {{baseUrl}}/api/organizations
Content-Type: {{contentType}}

{
  "name": "Test2 Agency",
  "email": "agency2@example.com",
  "phone": "+1234567890",
  "website": "https://testagency.com",
  "address": "123 Main St, City, State",
  "adminName": "Agency Admin",
  "adminEmail": "admin2@agency.com",
  "adminPassword": "AdminPass123!"
}

### 12. Get All Organizations
GET {{baseUrl}}/api/organizations
Content-Type: {{contentType}}

### 13. Get Organization by ID
GET {{baseUrl}}/api/organizations/{{orgId}}
Content-Type: {{contentType}}

### 14. Update Organization (SUPER_ADMIN only)
PATCH {{baseUrl}}/api/organizations/{{orgId}}
Content-Type: {{contentType}}

{
  "name": "Updated Agency Name"
}

### 15. Delete Organization (SOFT DELETE - SUPER_ADMIN only)
DELETE {{baseUrl}}/api/organizations/{{orgId}}
Content-Type: {{contentType}}


####################################
# Client Endpoints
####################################

### 16. Create Client (SUPER_ADMIN or AGENCY_ADMIN)
POST {{baseUrl}}/api/clients
Content-Type: {{contentType}}

{
  "businessName": "Local Pizza Shop",
  "website": "https://localpizza.com",
  "businessCategory": "Restaurant",
  "location": "Downtown, City",
  "phone": "+1234567890",
  "email": "contact@localpizza.com",
  "timezone": "America/New_York",
  "organization": "{{orgId}}"
}

### 17. Get All Clients (with pagination, search, status filter)
GET {{baseUrl}}/api/clients?page=1&limit=20&search=pizza&status=active
Content-Type: {{contentType}}

### 18. Get Client by ID
GET {{baseUrl}}/api/clients/{{clientId}}
Content-Type: {{contentType}}

### 19. Update Client
PATCH {{baseUrl}}/api/clients/{{clientId}}
Content-Type: {{contentType}}

{
  "businessName": "Updated Pizza Shop",
  "phone": "+1987654321"
}

### 20. Delete Client (SOFT DELETE - status='inactive')
DELETE {{baseUrl}}/api/clients/{{clientId}}
Content-Type: {{contentType}}


####################################
# Roles Endpoints
####################################

# Setting role id
@roleId = 6a85e9b102697c93a8a41bbe

### 21. Create Role (SUPER_ADMIN or AGENCY_ADMIN)
POST {{baseUrl}}/api/roles
Content-Type: {{contentType}}

{
  "name": "Content Manager",
  "description": "Can manage clients and leads",
  "organization": "{{orgId}}",
  "permissions": ["clients:read", "clients:write", "leads:read", "leads:write"]
}

### 22. Get All Roles (SUPER_ADMIN or AGENCY_ADMIN)
GET {{baseUrl}}/api/roles
Content-Type: {{contentType}}

### 23. Get Available Permissions
GET {{baseUrl}}/api/roles/permissions
Content-Type: {{contentType}}

### 24. Assign Role to User (SUPER_ADMIN or AGENCY_ADMIN)
POST {{baseUrl}}/api/roles/assign
Content-Type: {{contentType}}

{
  "user": "REPLACE_WITH_USER_ID",
  "role": "{{roleId}}",
  "client": "{{clientId}}"
}

### 25. Get User Roles
GET {{baseUrl}}/api/roles/user/6a860281c19b7485ae62ab76
Content-Type: {{contentType}}

### 26. Get Role by ID
GET {{baseUrl}}/api/roles/{{roleId}}
Content-Type: {{contentType}}

### 27. Update Role (SUPER_ADMIN or AGENCY_ADMIN)
PATCH {{baseUrl}}/api/roles/{{roleId}}
Content-Type: {{contentType}}

{
  "name": "Updated Content Manager",
  "description": "Updated description",
  "permissions": ["clients:read", "clients:write", "leads:read", "leads:write", "reports:read"]
}

### 28. Delete Role Assignment
DELETE {{baseUrl}}/api/roles/assign/REPLACE_WITH_ASSIGNMENT_ID
Content-Type: {{contentType}}

### 29. Delete Role (SOFT DELETE - SUPER_ADMIN or AGENCY_ADMIN)
DELETE {{baseUrl}}/api/roles/{{roleId}}
Content-Type: {{contentType}}


####################################
# Isolation & Security Tests
####################################

### TEST 1: Cross-org client access (should return 403)
# Login as demo admin, then try to access a client from another organization
GET {{baseUrl}}/api/clients/{{clientId}}
Content-Type: {{contentType}}

### TEST 2: Admin creating organization (should return 403)
# Login as demo admin, then try to create an organization
POST {{baseUrl}}/api/organizations
Content-Type: {{contentType}}

{
  "name": "Unauthorized Agency",
  "email": "unauthorized@example.com",
  "adminName": "Unauthorized Admin",
  "adminEmail": "unauthorizedadmin@example.com",
  "adminPassword": "Pass123!"
}

### TEST 3: Modifying system role (should return 403)
# Try to modify the AGENCY_ADMIN system role (isSystem=true)
PATCH {{baseUrl}}/api/roles/REPLACE_WITH_SYSTEM_ROLE_ID
Content-Type: {{contentType}}

{
  "name": "Hacked Admin Role",
  "permissions": ["clients:delete"]
}

### TEST 4: Invalid permission (should return 400)
# Try to create a role with invalid permissions
POST {{baseUrl}}/api/roles
Content-Type: {{contentType}}

{
  "name": "Invalid Role",
  "organization": "{{orgId}}",
  "permissions": ["invalid:permission", "another:invalid"]
}

### TEST 5: Duplicate role assignment (should return 409)
# Try to assign the same role to the same user twice
POST {{baseUrl}}/api/roles/assign
Content-Type: {{contentType}}

{
  "user": "REPLACE_WITH_USER_ID",
  "role": "{{roleId}}"
}

### TEST 6: Cross-org role access (should return 403)
# Login as demo admin, then try to access a role from another organization
GET {{baseUrl}}/api/roles/REPLACE_WITH_OTHER_ORG_ROLE_ID
Content-Type: {{contentType}}


