### Metriva NestJS API Endpoints - REST Client File
### Base URL: http://localhost:5000 (or http://localhost:5001)
### Use this file with REST Client extension in VS Code or similar HTTP client

@baseUrl = http://localhost:5000
@contentType = application/json

####################################
# Health Check (Public Endpoints)
####################################

### Health Check 1 (/api/health)
GET {{baseUrl}}/api/health

### Health Check 2 (/health)
GET {{baseUrl}}/health


####################################
# Authentication Endpoints
####################################

### 1. Register New User
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "name": "Test User",
  "email": "testuser@example.com",
  "password": "Password123!"
}

### 2. Send OTP (Email Verification)
POST {{baseUrl}}/api/auth/send-otp
Content-Type: {{contentType}}

{
  "email": "testuser@example.com"
}

### 3. Verify OTP (Enter the code printed in server console or email)
POST {{baseUrl}}/api/auth/verify-otp
Content-Type: {{contentType}}

{
  "email": "testuser@example.com",
  "otp": "123456"
}

### 4. Resend OTP
POST {{baseUrl}}/api/auth/resend-otp
Content-Type: {{contentType}}

{
  "email": "testuser@example.com"
}

### 5. Login User
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "admin@metriva.com",
  "password": "SuperAdmin@123!"
}

### 6. Get Current Authenticated User (Requires Login Cookie)
GET {{baseUrl}}/api/auth/me
Content-Type: {{contentType}}

### 7. Forgot Password (Request Reset Link)
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "testuser@example.com"
}

### 8. Reset Password (Use token logged to server console or email)
POST {{baseUrl}}/api/auth/reset-password
Content-Type: {{contentType}}

{
  "token": "REPLACE_WITH_RESET_TOKEN_FROM_CONSOLE",
  "password": "NewPassword123!"
}

### 9. Refresh Access Token
POST {{baseUrl}}/api/auth/refresh
Content-Type: {{contentType}}

### 10. Logout User
POST {{baseUrl}}/api/auth/logout
Content-Type: {{contentType}}


####################################
# Organization Endpoints
####################################

# Setting organization and client id
# Replace with the actual values from previous responses
@orgId = 6a85e7b102697c93a8a41bbc
@clientId = 6a85e8b102697c93a8a41bbd

### 11. Create Organization (SUPER_ADMIN only)
POST {{baseUrl}}/api/organizations
Content-Type: {{contentType}}

{
  "name": "Test Agency",
  "email": "agency@example.com",
  "phone": "+1234567890",
  "website": "https://testagency.com",
  "address": "123 Main St, City, State",
  "adminName": "Agency Admin",
  "adminEmail": "admin@agency.com",
  "adminPassword": "AdminPass123!"
}

### 12. Get All Organizations
GET {{baseUrl}}/api/organizations
Content-Type: {{contentType}}

### 13. Get Organization by ID
GET {{baseUrl}}/api/organizations/{{orgId}}
Content-Type: {{contentType}}

### 14. Update Organization (SUPER_ADMIN only)
PATCH {{baseUrl}}/api/organizations/{{orgId}}
Content-Type: {{contentType}}

{
  "name": "Updated Agency Name"
}

### 15. Delete Organization (SOFT DELETE - SUPER_ADMIN only)
DELETE {{baseUrl}}/api/organizations/{{orgId}}
Content-Type: {{contentType}}


####################################
# Client Endpoints
####################################

### 16. Create Client (SUPER_ADMIN or AGENCY_ADMIN)
POST {{baseUrl}}/api/clients
Content-Type: {{contentType}}

{
  "businessName": "Local Pizza Shop",
  "website": "https://localpizza.com",
  "businessCategory": "Restaurant",
  "location": "Downtown, City",
  "phone": "+1234567890",
  "email": "contact@localpizza.com",
  "timezone": "America/New_York",
  "organization": "{{orgId}}"
}

### 17. Get All Clients (with pagination, search, status filter)
GET {{baseUrl}}/api/clients?page=1&limit=20&search=pizza&status=active
Content-Type: {{contentType}}

### 18. Get Client by ID
GET {{baseUrl}}/api/clients/{{clientId}}
Content-Type: {{contentType}}

### 19. Update Client
PATCH {{baseUrl}}/api/clients/{{clientId}}
Content-Type: {{contentType}}

{
  "businessName": "Updated Pizza Shop",
  "phone": "+1987654321"
}

### 20. Delete Client (SOFT DELETE - status='inactive')
DELETE {{baseUrl}}/api/clients/{{clientId}}
Content-Type: {{contentType}}
